  runUpload() {
    if (!this.state.gstFilled) return;
    if (this.upTimer) clearTimeout(this.upTimer);
    if (this.upClock) clearInterval(this.upClock);
    const willFail = !this.state.upTried;
    this.setState({ upStep: 0, upElapsed: 0, upDone: null, upChip: null, upTried: true });
    this.upClock = setInterval(() => this.setState(s => ({ upElapsed: (s.upElapsed || 0) + 1 })), 1000);
    this.upTimer = setTimeout(() => this.advanceUpload(willFail), 2600);
  }

  // steps 1 & 2 take 2.6s each; step 3 (Confirming with GSTN) holds ~7.5s
  advanceUpload(willFail) {
    this.setState(s => {
      const next = (s.upStep || 0) + 1;
      if (next >= 3) {
        clearInterval(this.upClock);
        const ok = !willFail;
        const log = {
          when: this.fmt(new Date()), user: 'support@mastersindia.co',
          message: ok
            ? 'Uploaded to GSTN' + Math.floor(Math.random() * 9000 + 1000)
            : '3 tables rejected — Tables 16, 17, 18 · 6 errors found',
          msgColor: ok ? '#221E1F' : '#EF2F2F',
          hasFile: !ok, noFile: ok
        };
        if (ok) {
          if (this.toastTimer) clearTimeout(this.toastTimer);
          this.toastTimer = setTimeout(() => this.setState({ toast: null, toastKind: null }), 4000);
        }
        return {
          upStep: 3, upDone: ok ? 'ok' : 'fail', upTook: s.upElapsed || 0,
          uploadedOnce: ok ? true : s.uploadedOnce, upAt: this.fmt(new Date()),
          toast: ok ? 'Upload successful — GSTR-9 sent to GSTN' : s.toast,
          uploadLogs: [log].concat(s.uploadLogs || [])
        };
      }
      this.upTimer = setTimeout(() => this.advanceUpload(willFail), next === 2 ? 7500 : 2600);
      return { upStep: next };
    });
  }

