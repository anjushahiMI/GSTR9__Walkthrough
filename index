          : 'All ' + defs.length + ' tables imported without errors.';
      })(),
      miRows: this.miTableDefs().map((d, i) => ({
        no: d.no, name: d.name,
        clean: d.errors === 0, faulty: d.errors > 0,
        errorLabel: d.errors + (d.errors === 1 ? ' Error' : ' Errors'),
        optionLabel: d.no + ' — ' + d.name,
        open: () => this.setState({ miTab: 'view', miIndex: i, miDropOpen: false })
      })),
      miCurrentLabel: (() => {
        const d = this.miTableDefs()[this.state.miIndex || 0];
        return d.no + ' — ' + d.name;
      })(),
      miTableHasErrors: this.miTableDefs()[this.state.miIndex || 0].errors > 0,
      miTableClean: this.miTableDefs()[this.state.miIndex || 0].errors === 0,
      miTableSubtitle: (() => {
        const d = this.miTableDefs()[this.state.miIndex || 0];
        return d.errors ? 'Errors found in ' + d.errors + (d.errors === 1 ? ' field.' : ' fields.') + ' Correct the errors and re-upload the entire file.'
          : 'No errors in this table.';
      })(),
      miSubtitleColor: this.miTableDefs()[this.state.miIndex || 0].errors > 0 ? '#EF2F2F' : '#6E6E6E',
      miErrorList: (() => {
        const d = this.miTableDefs()[this.state.miIndex || 0];
        const badCols = d.badCols || [];
        const tally = {};
        d.rows.forEach(r => {
          badCols.forEach(ci => {
            const v = String(r[ci] === undefined ? '' : r[ci]);
            const blank = v.trim() === '';
            const alpha = /[A-Za-z]/.test(v);
            const special = /[^0-9.,\s—-]/.test(v);
            const pair = this.miPairBad(d, r, ci);
            if (!blank && !alpha && !special && !pair) return;
            const col = d.cols[ci];
            const why = pair ? 'does not match Central Tax. CGST and SGST must be equal' : blank
              ? 'is a mandatory field and cannot be empty'
              : (alpha
                ? 'has alphabets in a numeric field'
