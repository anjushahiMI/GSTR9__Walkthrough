      viewIsMI: !!(this.state.viewRow && this.state.viewRow.type === 'MI Offline Utility (GSTR-9)' && !this.state.viewRow.gstinMismatch),
      viewGstinMismatch: !!(this.state.viewRow && this.state.viewRow.gstinMismatch),
      viewIsHSN: !!(this.state.viewRow && this.state.viewRow.type !== 'MI Offline Utility (GSTR-9)' && !this.state.viewRow.gstinMismatch),
      miSummaryOpen: !!(this.state.viewRow && this.state.viewRow.type === 'MI Offline Utility (GSTR-9)' && !this.state.viewRow.gstinMismatch && (this.state.miTab || 'summary') === 'summary'),
      miViewOpen: !!(this.state.viewRow && this.state.viewRow.type === 'MI Offline Utility (GSTR-9)' && !this.state.viewRow.gstinMismatch && this.state.miTab === 'view'),
      showMiSummary: () => this.setState({ miTab: 'summary', miDropOpen: false }),
      showMiView: () => this.setState({ miTab: 'view' }),
      toggleMiDrop: () => this.setState(s => ({ miDropOpen: !s.miDropOpen })),
      miDropOpen: !!this.state.miDropOpen,
      miSummarySubtitle: (() => {
        const defs = this.miTableDefs();
        const faulty = defs.filter(d => d.errors > 0).length;
        return faulty
