  invalidHsns() {
    if (!this.hsnBadOn() || !this.state.gstFilled) return [];
    const S = this._S || [];
    const ed = this.state.gstEdits || {};
    const out = [];
    [10, 11].forEach(si => {
      const sec = S[si];
      if (!sec || sec.empty) return;
      const gone = (this.state.gstDel || {})[si] || [];
      (sec.rows || []).forEach((r, ri) => {
        if (gone.indexOf(ri) !== -1) return;
        const k = si + '-' + ri + '-0';
        const v = String(ed[k] !== undefined ? ed[k] : r[0]).trim();
        if (!/^(\d{4}|\d{6}|\d{8})$/.test(v)) out.push({ si: si, ri: ri, v: v });
      });
