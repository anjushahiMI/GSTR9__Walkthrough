    if (this.lockedByOther()) return 'Kriti Gupta is editing this return. Upload is disabled in view-only mode.';
    if (!this.state.gstFilled) return 'Fill in the tables to upload to GSTN.';
    if (this.isEditingTable()) return 'Save or cancel the table you are editing before uploading to GSTN.';
    if (this.isUploading()) return 'An upload is already in progress.';
    if (this.invalidHsns().length) {
      const t = this.invalidHsns().map(x => x.si === 10 ? '17' : '18').filter((v, i, a) => a.indexOf(v) === i);
