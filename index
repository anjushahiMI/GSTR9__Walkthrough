          column: k.split('|')[0],
          why: k.split('|')[1]
        }));
      })(),
      miEditing: !!this.state.miEditMode,
      miIdle: !this.state.miEditMode,
      miShowEdit: !this.state.miEditMode &&
        (this.miTableDefs()[this.state.miIndex || 0].errors || 0) > 0,
      editLocked: !(this.state.viewRow && this.state.viewRow.latest),
      editBtnBg: (this.state.viewRow && this.state.viewRow.latest) ? '#fff' : '#F4F7FA',
      editBtnFg: (this.state.viewRow && this.state.viewRow.latest) ? '#182A88' : '#bcbaba',
      editBtnCursor: (this.state.viewRow && this.state.viewRow.latest) ? 'pointer' : 'not-allowed',
      editBtnOpacity: (this.state.viewRow && this.state.viewRow.latest) ? 1 : 0.6,
      editTipOpen: !!this.state.editTip && !(this.state.viewRow && this.state.viewRow.latest),
      editTipOn: () => this.setState({ editTip: true }),
      editTipOff: () => this.setState({ editTip: null }),
      miStartEdit: () => {
        if (!(this.state.viewRow && this.state.viewRow.latest)) return;
        this.setState(s => ({ miEditMode: true, miDraft: Object.assign({}, s.miEdits || {}), miTip: null }));
      },
      miCancelEdit: () => this.setState(s => ({ miEditMode: false, miEdits: Object.assign({}, s.miDraft || {}) })),
      miSaveEdit: () => this.setState({ miEditMode: false, miDraft: null }),
      miCols: this.miTableDefs()[this.state.miIndex || 0].cols.map((c, i) => ({
        label: i === 0 ? 'Nature of Supplies' : c,
        align: i === 0 ? 'left' : 'right'
      })),
      miTableRows: (() => {
        const d = this.miTableDefs()[this.state.miIndex || 0];
        const badCols = d.badCols || [];
        const suspect = v => String(v).trim() === '' || /[A-Za-z]/.test(String(v)) || /[^0-9.,\s—-]/.test(String(v));
        const reason = v => String(v).trim() === ''
          ? 'Taxable value is empty. This field is mandatory.'
          : (/[A-Za-z]/.test(String(v))
            ? 'Alphabets are not allowed in a numeric field.'
            : 'Special characters are not allowed.');
        const edits = this.state.miEdits || {};
        const ti = this.state.miIndex || 0;
        return d.rows.map((r, ri) => {
          const srMatch = String(r[0]).match(/^([A-Z][0-9]?)\s{2}(.*)$/);
          const sr = srMatch ? srMatch[1] : (String(r[0]).match(/^(1[0-9])\s{2}/) ? String(r[0]).match(/^(1[0-9])\s{2}/)[1] : '');
          const saved = !this.state.miEditMode;
          const rowBad = r.some((v, ci) => badCols.indexOf(ci) !== -1 && (suspect(v) || this.miPairBad(d, r, ci)));
          const rowTouched = r.some((v, ci) => edits[ti + '-' + ri + '-' + ci] !== undefined);
          const cleared = saved && rowTouched && !rowBad;
          return {
          sr: sr,
          rowBg: 'transparent',
          cells: r.map((raw0, ci) => {
            const key0 = ti + '-' + ri + '-' + ci;
            const shown = edits[key0] !== undefined ? edits[key0] : raw0;
            const v = ci === 0 ? String(shown).replace(/^([A-Z][0-9]?|1[0-9])\s{2}/, '') : shown;
            const key = ti + '-' + ri + '-' + ci;
            const pairBad = badCols.indexOf(ci) !== -1 && this.miPairBad(d, r.map((x, cj) => edits[ti + '-' + ri + '-' + cj] !== undefined ? edits[ti + '-' + ri + '-' + cj] : x), ci);
            const bad = badCols.indexOf(ci) !== -1 && (suspect(v) || pairBad);
            // a cell stays editable while in edit mode if it was an error at import or has been touched
            const wasBad = (d.rawBadCols || badCols).indexOf(ci) !== -1 && (suspect(d.rawRows ? d.rawRows[ri][ci] : raw0) || this.miPairBad(d, d.rawRows ? d.rawRows[ri] : r, ci));
            const active = !!this.state.miEditMode && (bad || wasBad || edits[key] !== undefined);
            const fixed = edits[key] !== undefined && !bad;
            return {
              align: ci === 0 ? 'left' : 'right',
              justify: ci === 0 ? 'flex-start' : 'flex-end',
              v: v, bad: bad && !active, ok: !bad && !active, editing: active,
              cleared: cleared && fixed,
              fixedBg: fixed ? 'rgba(25,118,210,0.10)' : 'transparent',
              size: String(v).length + 1,
              minW: (String(v).length * 7.5 + 22) + 'px',
              editBorder: bad ? 'rgba(239,47,47,0.5)' : '#DFDFDF',
              editBg: bad ? 'rgba(239,47,47,0.06)' : '#FBFBFB',
              reason: bad ? (pairBad ? 'CGST and SGST must be equal.' : reason(v)) : '',
              tipOpen: this.state.miTip === key,
              showTip: () => this.setState({ miTip: key }),
              hideTip: () => this.setState({ miTip: null }),
              edit: null,
              onInput: e => {
                const nv = e.target.value;
                this.setState(s => {
                  const m = Object.assign({}, s.miEdits || {});
                  m[key] = nv;
                  return { miEdits: m };
                });
              }
            };
          })
        };
        });
      })(),
      stop: (e) => e.stopPropagation(),
      detailCols: ['Business GSTIN', 'HSN', 'Description', 'UQC', 'Total Quantity', 'Taxable Value', 'Rate',
        'IGST Amount', 'CGST Amount', 'SGST Amount', 'CESS Amount'],
      detailRows: hsnList,
      closeOverTip: () => this.setState({ overTip: null }),
      iconWarning: I.warning,
      errTipLeft: ((this.state.errPos || {}).x || 0) + 'px',
      errTipTop: ((this.state.errPos || {}).y || 0) + 'px',
      errTipShift: (this.state.errPos || {}).up ? 'translateY(-100%)' : 'none',
      detailNoRows: hsnList.length === 0,


      hsnEditing: !!this.state.hsnEdit,
      hsnIdle: !this.state.hsnEdit,
      hsnShowEdit: !this.state.hsnEdit && !!(this.state.viewRow && !this.state.viewRow.noEdit && (this.state.viewRow.hasErrors || this.state.viewRow.svc)),
      iconSort: I.sort,
      hsnSortBorder: this.state.hsnSort ? '#182A88' : '#DFDFDF',
      hsnSortBg: this.state.hsnSort ? 'rgb(236,239,252)' : '#fff',
      hsnSortFg: this.state.hsnSort ? '#182A88' : '#6E6E6E',
      hsnSortOpacity: this.hsnSortable() ? 1 : 0.4,
      hsnSortEvents: this.hsnSortable() ? 'auto' : 'none',
      cycleHsnSort: () => {
        if (!this.hsnSortable()) return;
        this.setState(s => ({
          hsnSort: s.hsnSort === 'errors' ? 'clean' : (s.hsnSort === 'clean' ? null : 'errors')
        }));
      },
      hsnStartEdit: () => {
        if (!(this.state.viewRow && this.state.viewRow.latest)) return;
        this.setState(s => ({ hsnEdit: true, hsnDraft: Object.assign({}, s.hsnEdits || {}), errorRow: null }));
      },
      hsnCancelEdit: () => this.setState(s => ({ hsnEdit: false, hsnEdits: Object.assign({}, s.hsnDraft || {}) })),
      hsnSaveEdit: () => this.setState(s => {
        if (s.hsnCase && s.viewRow && s.viewRow.hsnFile) return { hsnEdit: false, hsnDraft: null };
        if (!(s.svcImport && s.viewRow && s.viewRow.svc)) return { hsnEdit: false, hsnDraft: null };
        // services always save as UQC NA and quantity 0
        const m = Object.assign({}, s.hsnEdits || {});
        this.svcDetailData().forEach((r, i) => {
          if (/^99/.test(String(r.cells[0].v).trim())) { m[i + '-2'] = 'NA'; m[i + '-3'] = '0'; }
        });
        return { hsnEdit: false, hsnDraft: null, hsnEdits: m };
      }),
      closeErrorPopup: () => this.setState({ errorRow: null }),
      iconCheck: I.check,
      submit: () => this.startJob(),
      fetchOpen: this.state.fetchOpen,
      openFetch: () => this.setState({ fetchOpen: true }),
      closeFetch: () => this.setState({ fetchOpen: false }),
      fetchBusy: this.state.fetches.every(f => f.loading),
      fetchAllBg: this.state.fetches.every(f => f.loading) ? '#E4E4E4' : '#182A88',
      fetchAllColor: this.state.fetches.every(f => f.loading) ? '#9E9E9E' : '#fff',
      fetchAllCursor: this.state.fetches.every(f => f.loading) ? 'not-allowed' : 'pointer',
      fetchAll: () => {
        const sel = Object.keys(this.state.fetchSel || {}).map(Number);
        const targets = (sel.length ? sel : this.state.fetches.map((f, i) => i)).filter(i => !this.state.fetches[i].loading);
        if (targets.length) this.runFetch(targets);
      },
      fetchAllLabel: (() => {
        if (this.state.fetches.every(f => f.loading)) return 'Fetching…';
        const n = Object.keys(this.state.fetchSel || {}).length;
        return n ? 'Fetch (' + n + ')' : 'Fetch All';
      })(),
      fetchAnySel: Object.keys(this.state.fetchSel || {}).length === this.state.fetches.length && this.state.fetches.length > 0,
      fetchSomeSel: false,
      fetchAllBorder: (Object.keys(this.state.fetchSel || {}).length === this.state.fetches.length && this.state.fetches.length > 0) ? '#182A88' : '#9E9E9E',
      fetchAllBoxBg: (Object.keys(this.state.fetchSel || {}).length === this.state.fetches.length && this.state.fetches.length > 0) ? '#182A88' : '#fff',
      fetchToggleAll: () => this.setState(s => {
        if (Object.keys(s.fetchSel || {}).length) return { fetchSel: {} };
        const m = {};
        s.fetches.forEach((f, i) => { m[i] = true; });
        return { fetchSel: m };
      }),
      fetchLogOpen: this.state.fetchLog !== null && this.state.fetchLog !== undefined,
      closeFetchLog: () => this.setState({ fetchLog: null }),
      fetchLogTitle: (() => {
        const fx = this.state.fetches[this.state.fetchLog];
        if (!fx) return '';
        const fy = fx.parts[0].period.indexOf('2025') !== -1 ? '2025-26' : '2026-27';
        return fx.parts[0].type + ' \u2016 ' + fy;
      })(),
      fetchLogHasFail: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && !fx.loading && !fx.never && fx.parts.some(p => !p.ok); })(),
      fetchLogPrepFail: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && !fx.loading && fx.prep === 'failed'; })(),
      fetchLogStripOpen: (() => { const fx = this.state.fetches[this.state.fetchLog]; if (!fx) return false; return fx.loading || fx.never || fx.prep === 'failed' || fx.parts.some(p => !p.ok); })(),
      fetchLogClean: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !fx || (!fx.loading && !fx.never && fx.prep === 'done' && fx.parts.every(p => p.ok)); })(),
      fetchLogPrepRunning: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && fx.prep === 'running'; })(),
      fetchLogPrepShow: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && !fx.never && fx.prep !== 'idle'; })(),
      fetchLogPrepPct: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx ? fx.prepPct + '%' : '0%'; })(),
      fetchLogPrepPctText: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx ? fx.prepPct + '%' : ''; })(),
      fetchLogPrepDone: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && fx.prep === 'done'; })(),
      fetchLogPrepTitle: (() => { const fx = this.state.fetches[this.state.fetchLog]; if (!fx) return ''; return fx.prep === 'done' ? 'File is Ready for Download' : (fx.prep === 'failed' ? 'File Could Not Be Prepared' : 'Preparing File for Download'); })(),
      fetchLogPrepBorder: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx && fx.prep === 'failed' ? 'rgba(239,47,47,0.4)' : '#E8E8E8'; })(),
      fetchLogPrepBg: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx && fx.prep === 'failed' ? 'rgba(239,47,47,0.05)' : '#F7F8FA'; })(),
      fetchLogPrepIconColor: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx && fx.prep === 'failed' ? '#EF2F2F' : '#182A88'; })(),
      fetchLogPrepBarShow: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && fx.prep !== 'done'; })(),
      fetchLogPrepMsg: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx ? fx.prepMsg : ''; })(),
      fetchLogPrepBar: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx && fx.prep === 'failed' ? '#EF2F2F' : (fx && fx.prep === 'done' ? 'rgb(46,191,100)' : '#182A88'); })(),
      fetchLogNever: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && !fx.loading && !!fx.never; })(),
      fetchLogRunning: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && !!fx.loading && fx.prep !== 'running'; })(),
      fetchLogProgress: (() => {
        const fx = this.state.fetches[this.state.fetchLog];
        if (!fx) return '';
        const done = fx.parts.filter(p => !p.loading).length;
        return done + ' of ' + fx.parts.length + ' periods fetched';
      })(),
      fetchLogBusy: (() => { const fx = this.state.fetches[this.state.fetchLog]; return !!fx && fx.loading; })(),
      fetchLogRetryBg: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx && fx.loading ? '#E4E4E4' : '#182A88'; })(),
      fetchLogRetryFg: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx && fx.loading ? '#9E9E9E' : '#fff'; })(),
      fetchLogRetryCursor: (() => { const fx = this.state.fetches[this.state.fetchLog]; return fx && fx.loading ? 'not-allowed' : 'pointer'; })(),
      fetchLogRetry: () => {
        const idx = this.state.fetchLog;
        const fx = this.state.fetches[idx];
        if (!fx || fx.loading) return;
        const periodFail = fx.parts.some(p => !p.ok && !p.never);
        if (!periodFail && fx.prep === 'failed') { this.runFetch([idx], true, true); return; }
        this.runFetch([idx], true);
      },
      fetchLogShowRetry: (() => {
        const fx = this.state.fetches[this.state.fetchLog];
        if (!fx || fx.loading) return false;
        // header retry is for failed periods only — a failed file has its own retry on the card
        return fx.parts.some(p => !p.ok && !p.never);
      })(),
      fetchLogRows: (() => {
        const fx = this.state.fetches[this.state.fetchLog];
        if (!fx) return [];
        return fx.parts.map(p => ({
          type: p.type, period: p.period,
          msg: (p.loading || p.never) ? '—' : (p.ok ? 'No error found' : p.msg),
          msgColor: p.ok || p.loading ? '#6E6E6E' : '#221E1F',
          when: p.loading ? '—' : p.when,
          loading: !!p.loading, ok: !p.loading && p.ok && !p.never, failed: !p.loading && !p.ok && !p.never,
          rowBg: (!p.loading && !p.ok && !p.never) ? 'rgba(239,47,47,0.03)' : 'transparent'
        }));
      })(),
      fetchRows: this.state.fetches.map((f, i) => ({
        label: f.label.replace(/ : .*$/, '').replace(/ \(Govt Portal\)$/, ''), lastFetched: f.lastFetched,
        sub: / : /.test(f.label) ? f.label.split(' : ')[1] : (/ \(Govt Portal\)$/.test(f.label) ? 'Govt Portal' : ''),
        hasSub: / : /.test(f.label) || / \(Govt Portal\)$/.test(f.label),
        selected: !!(this.state.fetchSel || {})[i],
        ok: !f.loading && !f.failed && !f.never, failed: !f.loading && !!f.failed && !f.never,
        never: !f.loading && !!f.never,
        logBorder: f.failed ? 'rgba(239,47,47,0.5)' : '#DFDFDF',
        logBg: f.failed ? 'rgba(239,47,47,0.06)' : '#fff',
        logFg: f.failed ? '#EF2F2F' : '#182A88',
        openLogs: () => this.setState({ fetchLog: i }),
        fetchOne: () => {
          if (f.loading) return;
          this.runFetch([i]);
        },
        retry: () => {
          if (f.loading) return;
          if (f.prep === 'failed') { this.runFetch([i], true, true); return; }
          this.runFetch([i], true);
        },
        rowBg: 'transparent',
        boxBorder: (this.state.fetchSel || {})[i] ? '#182A88' : '#9E9E9E',
        boxBg: (this.state.fetchSel || {})[i] ? '#182A88' : '#fff',
        toggleSel: () => this.setState(s => {
          const m = Object.assign({}, s.fetchSel || {});
          if (m[i]) { delete m[i]; } else { m[i] = true; }
          return { fetchSel: m };
        }),
        loading: f.loading, idle: !f.loading,
        age: f.fresh ? 'Just now' : (f.lastFetched.indexOf('12-08-2026') === 0 ? 'Today' : 'Earlier this month'),
        pct: Math.round(f.progress || 0) + '%',
        eta: 'Est. ' + Math.max(1, Math.ceil((100 - (f.progress || 0)) * 0.04)) + 's remaining',
        actionColor: f.loading ? '#C9CDD8' : '#182A88',
        actionCursor: f.loading ? 'not-allowed' : 'pointer',
        refetch: () => {
          if (f.loading) return;
          this.runFetch([i]);
        }
      })),
      hasFiles: (this.state.files || []).length > 0,
      noFiles: (this.state.files || []).length === 0,
      files: (this.state.files || []).map((f, i) => ({
        name: f.name, size: f.size,
        remove: () => this.setState(s => ({ files: s.files.filter((_, j) => j !== i) }))
      })),
      dropLocked: (this.state.files || []).length > 0,
      dropTitle: (this.state.files || []).length > 0 ? 'One file per import' : 'Drag & drop your file here',
      dropBorder: (this.state.files || []).length > 0 ? '#E4E4E4' : '#C6CBDA',
      dropBg: (this.state.files || []).length > 0 ? '#F7F8FA' : '#FAFBFE',
      dropOpacity: (this.state.files || []).length > 0 ? 0.6 : 1,
      chooseBg: (this.state.files || []).length > 0 ? '#E4E4E4' : '#182A88',
      chooseFg: (this.state.files || []).length > 0 ? '#9E9E9E' : '#fff',
      chooseCursor: (this.state.files || []).length > 0 ? 'not-allowed' : 'pointer',
      addFile: () => this.setState(s => {
        const list = s.files || [];
        if (list.length) return {};
        return { files: list.concat([{
          name: (s.docType || 'Import') + '_Template_' + (list.length + 1) + '.xlsx',
          size: '184 KB'
        }]) };
      }),
      openDrawer: () => { if (!this.serverBlocked()) this.setState({ drawerOpen: true }); },
      closeDrawer: () => this.setState({ drawerOpen: false, docType: '', dropOpen: false, files: [] })
    };
  }
}

